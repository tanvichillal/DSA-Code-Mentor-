{
  "manifest_version": 3,
  "name": "AI DSA Mentor",
  "version": "1.0.0",
  "description": "Progressive DSA mentoring with automatic code detection, 2-minute thinking cooldowns, and contextual AI hints on LeetCode, CodeChef, and HackerRank.",
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "activeTab",
    "scripting",
    "tabs",
    "identity"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://www.codechef.com/*",
    "https://www.hackerrank.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open AI DSA Mentor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://www.codechef.com/problems/*",
        "https://www.codechef.com/*/problems/*",
        "https://www.codechef.com/practice/*",
        "https://www.hackerrank.com/challenges/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
